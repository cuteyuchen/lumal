{
  "name": "@lumal/vite",
  "type": "module",
  "version": "0.0.5-beta",
  "description": "Lumal Vite resolvers, workspace aliases, devtools helpers and scoped optional CSS viewport transforms.",
  "license": "MIT",
  "keywords": [
    "lumal",
    "vite",
    "vue",
    "resolver"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/src/index.d.ts",
  "files": [
    "CHANGELOG.md",
    "README.md",
    "dist"
  ],
  "scripts": {
    "build": "vite build --config vite.config.ts && tsc -p tsconfig.json --emitDeclarationOnly && node ../../scripts/clean-package-dist.mjs dist",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --config ../../vitest.config.ts tests"
  },
  "dependencies": {
    "picomatch": "^4.0.5",
    "postcss": "^8.5.16",
    "postcss-load-config": "^6.0.1",
    "postcss-value-parser": "^4.2.0"
  },
  "devDependencies": {
    "@types/picomatch": "^4.0.3"
  }
}
