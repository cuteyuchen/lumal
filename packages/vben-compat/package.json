{
  "name": "@lumal/vben-compat",
  "type": "module",
  "version": "0.1.0-beta",
  "description": "Lumal compatibility adapters for common Vben Admin APIs.",
  "license": "MIT",
  "keywords": [
    "lumal",
    "vue",
    "vben",
    "admin",
    "compat"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    "./style.css": "./dist/vben-compat.css",
    "./v5": {
      "types": "./dist/src/v5/index.d.ts",
      "import": "./dist/v5.js",
      "require": "./dist/v5.cjs"
    },
    "./v5/router": {
      "types": "./dist/src/v5/router.d.ts",
      "import": "./dist/v5-router.js",
      "require": "./dist/v5-router.cjs"
    },
    "./legacy": {
      "types": "./dist/src/legacy.d.ts",
      "import": "./dist/legacy.js",
      "require": "./dist/legacy.cjs"
    },
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/src/index.d.ts",
  "files": [
    "CHANGELOG.md",
    "README.md",
    "dist"
  ],
  "scripts": {
    "build": "vite build --config vite.config.ts && vue-tsc -p tsconfig.json --emitDeclarationOnly --outDir dist && node ../../scripts/clean-package-dist.mjs dist",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "test": "vitest run --config ../../vitest.config.ts tests"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "dependencies": {
    "@lumal/core": "0.1.0-beta",
    "@lumal/icons-vue": "0.1.0-beta",
    "@lumal/viewport": "0.1.0-beta"
  }
}
