{
  "compilerOptions": {
    "target": "ES2022",
    "jsx": "preserve",
    "useDefineForClassFields": true,
    "baseUrl": ".",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": { "@/*": ["src/*"] },
    "resolveJsonModule": true,
    "ignoreDeprecations": "6.0",
    "types": ["vite/client", "node"],
    "strict": true,
    "isolatedModules": true,
    "skipLibCheck": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.vue",
    "vite.config.ts"
  ]
}
