{
  "name": "create-lumal-admin",
  "type": "module",
  "version": "0.0.5-beta",
  "description": "Create a modular Lumal admin application with minimal, standard and Vben 5 presets.",
  "license": "MIT",
  "keywords": [
    "lumal",
    "vue",
    "admin",
    "scaffold",
    "create"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "create-lumal-admin": "./dist/cli.js"
  },
  "files": [
    "CHANGELOG.md",
    "README.md",
    "dist",
    "templates"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node ../../scripts/clean-package-dist.mjs dist && node ../../scripts/sync-create-lumal-admin-version.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "pnpm build && vitest run --config ../../vitest.config.ts tests"
  },
  "dependencies": {
    "@clack/prompts": "1.8.1"
  },
  "devDependencies": {
    "@lydell/node-pty": "1.2.0-beta.15"
  }
}
