  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@iconify/vue": "^5.0.0",
    "@lumal/charts": "0.0.7-beta",
    "@lumal/cockpit": "0.0.7-beta",
    "@lumal/core": "0.0.7-beta",
    "@lumal/datav": "0.0.7-beta",
    "@lumal/icons": "0.0.7-beta",
    "@lumal/icons-vue": "0.0.7-beta",
    "@lumal/viewport": "0.0.7-beta",
    "echarts": "^6.1.0",
    "element-plus": "^2.11.0",
    "vue": "^3.5.0",
    "vue-echarts": "^8.3.2",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.1",
    "typescript": "^6.0.0",
    "vite": "^8.0.0",
    "vue-tsc": "^3.1.1"
