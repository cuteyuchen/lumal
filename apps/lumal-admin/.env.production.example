# 推荐使用同域反向代理；跨域部署时填写完整 Mock API 地址。
VITE_API_BASE_URL=/api
# 独立驾驶舱应用地址：生产环境填写 lumal-cockpit 的完整域名。
VITE_COCKPIT_URL=https://lumal-cockpit.cuteyuchen.top/
# DataV 组件指南站地址：生产环境填写独立部署的完整域名。
VITE_DATAV_GUIDE_URL=https://lumal-datav.cuteyuchen.top/
# 部署版本提示默认开启（5 分钟）；仅在需要关闭或调整时取消注释。
# VITE_VERSION_CHECK=false
# VITE_VERSION_CHECK_INTERVAL=300000
# VITE_VERSION_CHECK_URL=/version.json
